{
  "manifest_version": 3,
  "name": "WebWhisper",
  "version": "0.1.0",
  "description": "An accessible side-panel assistant for vision-impaired users. Phase 1: UI shell.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open WebWhisper",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "permissions": ["sidePanel", "activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["shared/messages.js"], "matches": ["<all_urls>"] }
  ]
}
